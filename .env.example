# Copia este archivo a .env en el servidor (deploy/instalar_servidor.sh lo hace).
# Clave del usuario "tasktime" de Postgres. Inventa una larga; solo la usan los
# dos contenedores entre sí.
POSTGRES_PASSWORD=cambia_esta_clave

# Puerto de localhost en el que escucha la app en el servidor (el proxy apunta aquí).
WEB_PORT=3100
