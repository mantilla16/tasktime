# Copia este archivo a .env en el servidor (deploy/instalar_servidor.sh lo hace).
# Clave del usuario "tasktime" de Postgres. Inventa una larga; solo la usan los
# dos contenedores entre sí.
POSTGRES_PASSWORD=cambia_esta_clave

# Puerto de localhost en el que escucha la app en el servidor (el proxy apunta aquí).
WEB_PORT=3100

# Ingreso con Microsoft 365 (Entra ID), igual que analitica-puc: copia los
# mismos valores de su .env (es el mismo registro de aplicación en Azure).
# Sin estos dos valores la app usa contraseñas (solo para desarrollo local).
MS_TENANT_ID=
MS_CLIENT_ID=
# Dominio institucional con el que se puede entrar.
RB_DOMINIO=rbcol.co
