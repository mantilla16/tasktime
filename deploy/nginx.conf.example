# Bloques para publicar la app bajo una ruta del sitio existente, por ejemplo
# http://servidor/tasktime/. Pégalos dentro del `server { ... }` de
# /etc/nginx/sites-available/analitica-puc (antes de `location / {`) y recarga:
#   sudo nginx -t && sudo systemctl reload nginx
#
# proxy_pass termina en "/" para que la app reciba las rutas sin el prefijo
# (/tasktime/api/auth -> /api/auth). X-Forwarded-Prefix hace que la cookie de
# sesión quede limitada a /tasktime/ y no se mezcle con las otras apps del host.
# X-Forwarded-Proto marca la cookie como Secure cuando el sitio va por HTTPS.

location = /tasktime {
    return 301 /tasktime/;
}

location /tasktime/ {
    proxy_pass         http://127.0.0.1:3100/;
    proxy_http_version 1.1;
    proxy_set_header   Host               $host;
    proxy_set_header   X-Real-IP          $remote_addr;
    proxy_set_header   X-Forwarded-For    $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto  $scheme;
    proxy_set_header   X-Forwarded-Prefix /tasktime;
    proxy_read_timeout 60s;
}
